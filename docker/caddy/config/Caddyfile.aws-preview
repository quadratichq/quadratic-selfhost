{
  email quadratic@#HOST#
  cert_issuer acme https://acme.zerossl.com/v2/DV90
  cert_issuer acme https://acme-v02.api.letsencrypt.org/directory
}

#HOST# {
  reverse_proxy http://host.docker.internal:3000
}

api.#HOST# {
  reverse_proxy http://host.docker.internal:8000
}

multiplayer.#HOST# {
  reverse_proxy http://host.docker.internal:3001
}

session.#HOST# {
  reverse_proxy http://host.docker.internal:3001
}

# cloud-session branch: quadratic-session serves the files-service storage
# routes, so presigned URLs minted by quadratic-api keep working.
files.#HOST# {
  reverse_proxy http://host.docker.internal:3001
}

connection.#HOST# {
  reverse_proxy http://host.docker.internal:3003
}

cloud-controller.#HOST# {
  reverse_proxy http://host.docker.internal:3004
  reverse_proxy http://host.docker.internal:3005
}

mcp.#HOST# {
  reverse_proxy http://host.docker.internal:8090
}

developer-api.#HOST# {
  reverse_proxy http://host.docker.internal:3007
}
